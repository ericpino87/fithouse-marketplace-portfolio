<%- include('partials/head',{title:'Mi carrito'}) %>
<main class="container section page-top"><div class="section-heading"><div><p class="eyebrow dark">TU SELECCIÓN</p><h1>Carrito de compras</h1></div><a href="/productos" class="inline-link">Seguir explorando ↗</a></div>
<% if(lines.length){ %><div class="cart-layout"><div class="cart-items"><% lines.forEach(item=>{ %><article class="cart-item"><div class="cart-thumb"><%= item.emoji %></div><div class="cart-details"><h3><%= item.name %></h3><p><%= item.category %> · Cantidad: <%= item.quantity %></p><form method="post" action="/carrito/quitar"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= item.id %>"><button class="remove-button" type="submit">Quitar</button></form></div><strong><%= peso(item.subtotal) %></strong></article><% }) %></div>
<aside class="summary"><h2>Resumen de compra</h2><div class="summary-row"><span>Subtotal</span><strong><%= peso(total) %></strong></div><div class="summary-row muted"><span>Envío</span><span>No disponible</span></div><div class="summary-row total"><span>Total demo</span><strong><%= peso(total) %></strong></div><button class="button button-disabled" disabled title="Demo sin pagos reales">Compra no disponible</button><p>Este ejemplo no procesa transacciones.</p></aside></div>
<% }else{ %><div class="empty-state"><div>🛒</div><h2>Tu carrito está vacío</h2><p>Agregá un producto para probar el recorrido de compra.</p><a class="button button-primary" href="/productos">Explorar productos</a></div><% } %>
</main><%- include('partials/footer') %>
