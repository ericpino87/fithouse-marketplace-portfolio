<%- include('partials/head',{title:'Crear cuenta'}) %>
<main class="container auth-wrap"><section class="auth-card"><p class="eyebrow dark">EMPEZÁ ACÁ</p><h1>Crear cuenta demo</h1><p>No uses un correo ni una contraseña real. Los registros se guardan localmente.</p>
<% if(error){ %><p class="form-error" role="alert"><%= error %></p><% } %>
<form method="post" action="/usuario/register"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="name">Nombre</label><input type="text" id="name" name="name" minlength="2" maxlength="80" required><label for="email">Correo ficticio</label><input type="email" id="email" name="email" required><label for="password">Contraseña de prueba (8 caracteres mínimo)</label><input type="password" id="password" name="password" minlength="8" maxlength="72" required><button class="button button-primary full" type="submit">Crear cuenta</button></form>
<p class="form-bottom">¿Ya tenés una cuenta? <a href="/usuario/login">Ingresar</a></p></section></main>
<%- include('partials/footer') %>
