<%- include('partials/head',{title:'Panel demo'}) %>
<main class="container section page-top"><div class="section-heading"><div><p class="eyebrow dark">PANEL DEL USUARIO</p><h1>Administrar catálogo</h1></div><span class="count-label">MODO DEMOSTRACIÓN</span></div>
<div class="admin-layout"><section class="panel"><h2>Agregar producto</h2><p>Los cambios se guardan en JSON local, no en una base de datos de producción.</p>
<% if(error){ %><p class="form-error" role="alert"><%= error %></p><% } %>
<form method="post" action="/admin/productos" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="name">Nombre</label><input id="name" name="name" required minlength="3" maxlength="100"><label for="description">Descripción</label><textarea id="description" name="description" required minlength="10" maxlength="600" rows="3"></textarea><label for="category">Categoría</label><select id="category" name="category"><% categories.forEach(c=>{ %><option><%= c %></option><% }) %></select><label for="price">Precio ficticio (ARS)</label><input id="price" type="number" name="price" min="1" max="100000000" required><button class="button button-primary full">Agregar producto</button></form></section>
<section class="panel"><h2>Productos (<%= products.length %>)</h2><div class="admin-list"><% products.forEach(p=>{ %><div class="admin-product"><div><strong><%= p.name %></strong><p><%= peso(p.price) %></p></div><form method="post" action="/admin/productos/<%= p.id %>/delete" onsubmit="return confirm('¿Quitar el producto de esta demo?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="remove-button">Eliminar</button></form></div><% }) %></div></section></div>
</main><%- include('partials/footer') %>
