<%- include('partials/head',{title:'Catálogo'}) %>
<main class="container section page-top">
 <div class="section-heading"><div><p class="eyebrow dark">EXPLORÁ EL CATÁLOGO</p><h1>Productos de entrenamiento</h1></div><span class="count-label"><%= products.length %> artículos</span></div>
 <form class="catalog-filters" method="get" action="/productos"><label class="sr-only" for="q">Buscar productos</label><input type="search" id="q" name="q" placeholder="Buscar por nombre o categoría..." value="<%= q %>">
  <label class="sr-only" for="categoria">Categoría</label><select name="categoria" id="categoria"><option value="">Todas las categorías</option><% categories.forEach(c=> { %><option value="<%= c %>" <%= c===category?'selected':'' %>><%= c %></option><% }) %></select><button class="button button-primary" type="submit">Buscar</button><a class="clear-link" href="/productos">Limpiar</a>
 </form>
 <% if(products.length){ %><div class="product-grid"><% products.forEach(product=> { %><%- include('partials/card',{product}) %><% }) %></div>
 <% }else{ %><div class="empty-state"><div>🔎</div><h2>No encontramos resultados</h2><p>Probá con otros términos o categorías.</p><a class="button" href="/productos">Ver todos los productos</a></div><% } %>
 </main><%- include('partials/footer') %>
